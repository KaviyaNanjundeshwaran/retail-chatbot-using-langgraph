# Copy to backend/.env and fill in. Every value is validated at startup (src/config.ts); empty values count as unset.
# First deploy (and after upgrades): npm run db:setup

# ---- Server ----
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
APP_NAME=Returns & Refunds Assistant

# ---- Database (Supabase session pooler) ----
PG_URI=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
# verify = full TLS verification | no-verify = encrypted, certificate not checked | disable = no TLS
# Supabase's pooler certificate does not verify against the default CA store, so it needs no-verify (or a CA bundle).
PG_SSL=no-verify
PG_POOL_MAX=10

# ---- Auth ----
JWT_SECRET=<at least 32 random characters>
SESSION_TTL_HOURS=8
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=10
# Optional: db:setup creates this admin if it does not exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- LLM: gemini or mistral; the matching key and model are required ----
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=
# Optional endpoint override (proxy/gateway); empty = Google's default endpoint.
GEMINI_BASE_URL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
# Optional endpoint override; empty = Mistral's default endpoint.
MISTRAL_BASE_URL=
# Optional: a cheaper/faster model of the same provider for the input and output guardrails (defaults to the main model).
# Each customer message makes 3+ model calls (input guard, agent, output guard, plus one per tool step). On a free tier with a
# per-model requests-per-minute quota, a different guard model gets its own quota and roughly doubles chat throughput.
LLM_GUARD_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3

# ---- Chat limits ----
# Messages sent to the model per call (min 26).
CHAT_HISTORY_MESSAGES=30
CHAT_MAX_INPUT_CHARS=1500
CHAT_RATE_LIMIT_PER_MIN=15

# ---- SNS Agent Workbench webhooks ----
SNS_WORKBENCH_NOTIFICATION_URL=https://api.agents.snsihub.ai/webhook/customer-email-notification
SNS_WORKBENCH_ESCALATION_URL=https://api.agents.snsihub.ai/webhook/support-escalation-email
# Optional: sent as Bearer token and x-api-key.
SNS_WORKBENCH_API_KEY=
WORKBENCH_TIMEOUT_MS=10000
SUPPORT_TEAM_EMAIL=
