# Copy to frontend/.env.local. NEXT_PUBLIC_* values are inlined at build time.
# Backend API base URL (server-side proxy target for /api/*). Read when Next loads its config:
# live in `npm run dev`, but captured at `npm run build` for `npm start`, so set it before building.
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Returns & Refunds Assistant
